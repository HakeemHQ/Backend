{
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=.\\SQLEXPRESS;database=HakeemDb;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;"
    },
    "Database": {
        "AutoMigrate": true,
        "MigrationTimeoutSeconds": 300,
        "RetryCount": 3,
        "RetryDelaySeconds": 5,
        "Contexts": {
            "ApplicationDbContext": {
                "AutoMigrate": true
            }
        }
    },
    "Security": {
        "Jwt": {
            "Key": "development-key-for-testing-only-32-chars-minimum",
            "Issuer": "Hakeem.API",
            "Audience": "Hakeem.Users",
            "TokenExpirationMinutes": 10,
            "RefreshTokenExpirationDays": 7,
            "RequireHttpsMetadata": false,
            "SaveToken": false,
            "ValidateLifetime": true,
            "ClockSkew": "00:00:00"
        },
        "Cors": {
            "AllowedOrigins": [
                "http://localhost:3000",
                "http://localhost:3001",
                "http://localhost:4200",
                "http://localhost:8080",
                "https://localhost:7001",
                "http://localhost:5173",
                "https://financial-authority-audit-website.vercel.app"
            ],
            "AllowedMethods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "OPTIONS"
            ],
            "AllowedHeaders": [
                "Content-Type",
                "Authorization",
                "X-Requested-With",
                "X-Email",
                "Origin",
                "Accept"
            ],
            "AllowCredentials": true,
            "PreflightMaxAge": 86400
        },
        "Headers": {
            "EnableHsts": false,
            "HstsMaxAge": 31536000,
            "HstsIncludeSubdomains": true,
            "HstsPreload": true,
            "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none';",
            "ReferrerPolicy": "strict-origin-when-cross-origin",
            "PermissionsPolicy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Information",
                "System": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/Hakeem-dev-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "fileSizeLimitBytes": 10485760,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "FileStorage": {
        "BasePath": "wwwroot/uploads",
        "MaxFileSizeBytes": 10485760,
        "AllowedExtensions": [
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".bmp",
            ".webp",
            ".pdf",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".ppt",
            ".pptx",
            ".txt",
            ".zip",
            ".rar"
        ]
    },
    "FileSettings": {
        "BaseUrl": "https://manaber.runasp.net/"
    },
    "EmailConfig": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "SenderEmail": "Kariemgamal7777@gmail.com",
        "SenderName": "Hakeem Test",
        "Username": "Kariemgamal7777@gmail.com",
        "Password": "dgmp qgpr locq fopl"
    },
    "OutboxSettings": {
        "PollingIntervalSeconds": 10,
        "BatchSize": 20,
        "MaxRetries": 3,
        "RetryDelaySeconds": 60,
        "LockDurationSeconds": 120
    },
    "WebsiteSettings": {
        "BaseUrl": "https://financial-authority-audit-website.vercel.app"
    }
}
