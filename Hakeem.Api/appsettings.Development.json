{
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=.\\SQLEXPRESS;database=HakeemDb;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;"
    },
    "Database": {
        "AutoMigrate": true,
        "MigrationTimeoutSeconds": 300,
        "RetryCount": 3,
        "RetryDelaySeconds": 5,
        "Contexts": {
            "ApplicationDbContext": {
                "AutoMigrate": true
            }
        }
    },
    "Security": {
        "Jwt": {
            "Key": "development-key-for-testing-only-32-chars-minimum",
            "Issuer": "Hakeem.API",
            "Audience": "Hakeem.Users",
            "TokenExpirationMinutes": 120,
            "RefreshTokenExpirationDays": 7,
            "RequireHttpsMetadata": false,
            "SaveToken": false,
            "ValidateLifetime": true,
            "ClockSkew": "00:00:00"
        },
        "Cors": {
            "AllowedOrigins": [
                "http://localhost:3000",
                "http://localhost:3001",
                "http://localhost:4200",
                "http://localhost:8080",
                "https://localhost:7001",
                "http://localhost:5173"
            ],
            "AllowedMethods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "OPTIONS",
                "PATCH"
            ],
            "AllowedHeaders": [
                "Content-Type",
                "Authorization",
                "X-Requested-With"
            ],
            "AllowCredentials": true,
            "PreflightMaxAge": 86400
        },
        "Headers": {
            "EnableHsts": false,
            "HstsMaxAge": 31536000,
            "HstsIncludeSubdomains": true,
            "HstsPreload": true,
            "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';",
            "ReferrerPolicy": "strict-origin-when-cross-origin",
            "PermissionsPolicy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        }
    },
    "FileStorage": {
        "BasePath": "wwwroot/uploads",
        "MaxFileSizeBytes": 10485760,
        "AllowedExtensions": [
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".bmp",
            ".webp",
            ".pdf",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".ppt",
            ".pptx",
            ".txt",
            ".zip",
            ".rar"
        ]
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Information",
                "System": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/Hakeem-dev-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "fileSizeLimitBytes": 10485760,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "FileSettings": {
        "BaseUrl": "http://localhost:5109"
    },
    "OutboxSettings": {
        "PollingIntervalSeconds": 10,
        "BatchSize": 20,
        "MaxRetries": 3,
        "RetryDelaySeconds": 60,
        "LockDurationSeconds": 120
    },
    "EmailConfig": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "SenderEmail": "hakeem.notifications@gmail.com",
        "SenderName": "Hakeem",
        "Username": "hakeem.notifications@gmail.com",
        "EnableSsl": true
    },
    "WebsiteSettings": {
        "BaseUrl": "http://localhost:4200"
    },
    "MedicalIntelligenceAgent": {
        "SearchLimit": 15,
        "FocusedCvMinimumScore": 0.5,
        "FocusedCvRelatedEvidenceMinimumScore": 0.47
    },
    "DevelopmentUser": {
        "UserId": "11111111-1111-1111-1111-111111111111"
    },
    "HuggingFaceEmbedding": {
        "EmbeddingsEndpoint": "https://router.huggingface.co/scaleway/v1/embeddings",
        "ModelId": "qwen3-embedding-8b",
        "ApiKey": "SECRET",
        "Dimensions": 4096
    },
    "Qdrant": {
        "Host": "https://19d43c3c-3718-4c9d-b35c-81713d75f7f0.eu-west-2-0.aws.cloud.qdrant.io",
        "Port": 6334,
        "ApiKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NWQzNTk0NTctOTBmZC00MWJjLTljMTYtYmNkOTA0MjgwYTE5In0.6pAMF1Pq4c0WlnjYAnri8M2t0ipI-qi9HvJN6KvP2F8",
        "UseTls": true,
        "CollectionName": "medical_records",
        "VectorSize": 4096,
        "PayloadFields": [
            "medical_record_id",
            "patient_profile_id",
            "record_type",
            "display_name",
            "status",
            "clinical_date",
            "content",
            "fields"
        ]
    }
}
